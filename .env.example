# ---------------------------------------------------------------------------
# ShadowSpark Fleet — enterprise & bulk logistics (all optional at build time)
# ---------------------------------------------------------------------------

# Prisma/PostgreSQL — real backend only. NEVER queried during `next build`.
DATABASE_URL="postgresql://shadowspark:***@localhost:5432/delivery_enterprise_bulk?schema=public"

# ---------- AI agent (optional) ----------
# When OPENAI_API_KEY is set the /api/chat agent still uses the bundled
# rule-based MockLLM for the guaranteed-offline demo. To run a REAL LLM brain
# set OPENAI_API_KEY AND flip the swap switch in src/lib/agent.ts
# (createRealOrMockLLM returns MockLLM by default). Compatible with OpenAI /
# OpenRouter / DeepSeek base URLs.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# ---------- Payments (optional) ----------
# Placeholder gap — enterprise accounts settle invoiced; reserved for future.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# ---------- Maps (optional) ----------
# Render a live Mapbox map when set; otherwise a stylized static placeholder.
NEXT_PUBLIC_MAPBOX_TOKEN=""
